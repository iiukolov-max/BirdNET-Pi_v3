[Unit]
Description=BirdNET boot time, service startup and RTC diagnostics
After=birdnet_analysis.service birdnet_recording.service caddy.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/bin/startup_diagnostics.py --log-file /var/log/birdnet/startup.jsonl
LogsDirectory=birdnet
LogsDirectoryMode=0750
UMask=0027
TimeoutStartSec=90
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/log/birdnet
