[Unit]
Description=Refresh Charts once after completed archive analysis
After=birdnet-archive-analysis.service birdnet-minimal-services.service

[Service]
Type=oneshot
Environment=MPLBACKEND=Agg
Environment=OPENBLAS_NUM_THREADS=1
Environment=OMP_NUM_THREADS=1
ExecCondition=/usr/bin/python3 "@BIRDNET_ROOT@/scripts/archive_charts.py" check
ExecStart=/usr/bin/python3 "@BIRDNET_ROOT@/scripts/archive_charts.py" run
ExecStopPost=/usr/bin/python3 "@BIRDNET_ROOT@/scripts/archive_charts.py" recover
Nice=15
CPUWeight=10
IOWeight=10
TimeoutStartSec=300
TimeoutStopSec=30
Restart=no
