# A separate diagnostic callback; does not duplicate the gain-setting rule.
SUBSYSTEM=="sound", KERNEL=="card[0-9]*", ACTION=="add", RUN+="/usr/bin/python3 /usr/local/libexec/birdnet-audio-device-event.py"
SUBSYSTEM=="sound", KERNEL=="card[0-9]*", ACTION=="remove", RUN+="/usr/bin/python3 /usr/local/libexec/birdnet-audio-device-event.py"
